    "VAR_NOTES"   CDF_CHAR     { "The ADC bin count for CH1 is " -
                                 "dynamically configurable. The current " -
                                 "bin count is the NBIN global attribute" -
                                 " value, plus an overflow bin, plus an " -
                                 "underflow bin (NBIN + 2 total for " -
                                 "CH1).  The L0 CDF files shall be " -
                                 "generated from telemetry such that " -
                                 "NBIN is constant within a single CDF " -
                                 "file.   The maximum allowed value of " -
                                 "NBIN is 128, and the minimum allowed " -
                                 "value of NBIN is 4.   When NBIN is " -
                                 "less than 128, unused (placeholder) " -
                                 "bins in BINS_CH1_RAW are filled with " -
                                 "the FILLVAL." }
